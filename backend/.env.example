# ══════════════════════════════════════════════════
# UniSale API — environment
# Copy to backend/.env and fill in real values.
# ══════════════════════════════════════════════════

# ── Server ────────────────────────────────────────
PORT=5000
NODE_ENV=development

# Comma-separated list of allowed browser origins.
# The FIRST entry is treated as the canonical web app, and is where the
# Google OAuth callback redirects users back to.
CLIENT_URL=http://localhost:3000

# ── Database ──────────────────────────────────────
MONGO_URI=mongodb+srv://<user>:<pass>@cluster.mongodb.net/unisale

# ── JWT ───────────────────────────────────────────
# Use two different secrets, at least 32 characters each.
JWT_ACCESS_SECRET=replace_with_a_long_random_string_min_32_chars
JWT_REFRESH_SECRET=replace_with_a_different_long_random_string
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# ── Email (OTP delivery) ──────────────────────────
# Gmail requires an App Password, not your account password.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_email@gmail.com
SMTP_PASS=your_app_password
EMAIL_FROM="UniSale <noreply@unisale.in>"

# ── Google OAuth ──────────────────────────────────
GOOGLE_CLIENT_ID=your_google_client_id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your_google_client_secret
GOOGLE_CALLBACK_URL=http://localhost:5000/api/auth/google/callback

# ── Cloudflare R2 (listing photos) ────────────────
R2_ACCOUNT_ID=your_cloudflare_account_id
R2_ACCESS_KEY_ID=your_r2_access_key_id
R2_SECRET_ACCESS_KEY=your_r2_secret_access_key
R2_BUCKET_NAME=unisale-images
# Public bucket URL. The web app needs this same host in
# NEXT_PUBLIC_R2_PUBLIC_URL so next/image will load the photos.
R2_PUBLIC_URL=https://pub-<hash>.r2.dev
