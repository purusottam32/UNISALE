# ══════════════════════════════════════════════════
# UniSale web app — environment
# Copy to .env.local and fill in real values.
#
# Only NEXT_PUBLIC_* variables belong here: everything in this file is
# inlined into the browser bundle, so never put a secret in it.
# ══════════════════════════════════════════════════

# Base URL of the UniSale API, including the /api path.
NEXT_PUBLIC_API_URL=http://localhost:5000/api

# Public Cloudflare R2 bucket URL. Must match R2_PUBLIC_URL in backend/.env —
# next.config.ts reads this to allow the host in next/image.
NEXT_PUBLIC_R2_PUBLIC_URL=https://pub-<hash>.r2.dev
